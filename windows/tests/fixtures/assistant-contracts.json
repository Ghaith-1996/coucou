  "unparseable": [
    { "name": "an agent permission is not an assistant action", "action": { "v": 5, "domain": "agent-permission", "id": "x", "kind": "chat-draft", "args": { "text": "allow" }, "intentId": "i", "expiresAtMs": 1060000 } },
