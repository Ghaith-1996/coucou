    { "name": "an extra top-level field", "action": { "v": 5, "domain": "desktop-assistant", "id": "x", "kind": "chat-draft", "args": { "text": "hi" }, "intentId": "i", "expiresAtMs": 1060000, "requestId": "1" } }
