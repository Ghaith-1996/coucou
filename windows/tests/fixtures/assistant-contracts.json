{
  "_comment": "Read by src-tauri/src/assistant/mod.rs tests and tests/assistant-contracts.test.mjs: both sides of the assistant contracts must agree with it.",
  "version": 5,
  "voiceEvent": "assistant-voice",
  "actionKinds": [
    { "kind": "chat-draft", "available": true, "idempotent": true },
    { "kind": "pill-set", "available": true, "idempotent": true },
    { "kind": "insert-text", "available": true, "idempotent": false },
    { "kind": "launch-app", "available": true, "idempotent": false },
    { "kind": "ask-region", "available": false, "idempotent": false },
    { "kind": "switch-tab", "available": true, "idempotent": false },
    { "kind": "memory-save", "available": true, "idempotent": true },
    { "kind": "open-url", "available": true, "idempotent": false }
  ],
  "voiceStates": ["idle", "listening", "processing", "preview", "speaking", "error"],
  "voiceErrors": ["no-microphone", "microphone-denied", "silence", "provider"],
  "now": 1000000,
  "actions": [
    {
      "name": "a chat draft is allowed: it stays in Coucou and is never sent",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-1", "kind": "chat-draft", "args": { "text": "hello Mochi" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "allow"
    },
    {
      "name": "an expired action is refused, never run late",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-2", "kind": "chat-draft", "args": { "text": "late" }, "intentId": "cap-1", "expiresAtMs": 1000000 },
      "decision": "deny", "error": "expired"
    },
    {
      "name": "an action that expires too far ahead is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-3", "kind": "chat-draft", "args": { "text": "later" }, "intentId": "cap-1", "expiresAtMs": 99000000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a future contract version is refused",
      "action": { "v": 6, "domain": "desktop-assistant", "id": "act-4", "kind": "chat-draft", "args": { "text": "hi" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "version"
    },
    {
      "name": "a v1 action is refused before expiry or arguments are checked",
      "action": { "v": 1, "domain": "desktop-assistant", "id": "act-v1", "kind": "chat-draft", "args": { "text": 42 }, "intentId": "cap-1", "expiresAtMs": 0 },
      "decision": "deny", "error": "version"
    },
    {
      "name": "pill-set requires v2 rather than extending the frozen v1 registry",
      "action": { "v": 1, "domain": "desktop-assistant", "id": "act-pill-v1", "kind": "pill-set", "args": { "mainPill": "integration_claude", "activeIntegrations": [] }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "version"
    },
    {
      "name": "an extra argument is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-5", "kind": "chat-draft", "args": { "text": "hi", "send": true }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "an empty draft is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-6", "kind": "chat-draft", "args": { "text": "  \n " }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "control characters other than line breaks are refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-7", "kind": "chat-draft", "args": { "text": "hi\u001b[2J" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a reserved kind is refused in this version",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-8", "kind": "ask-region", "args": { "question": "what is this?", "monitor": "DISPLAY1", "x": 0, "y": 0, "width": 10, "height": 10 }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "unavailable"
    },
    {
      "name": "switching the user's browser tab reaches outside Coucou: the user confirms it",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-30", "kind": "switch-tab", "args": { "window": 4242, "tabId": "1.2", "title": "YouTube" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "ask"
    },
    {
      "name": "a tab id that is not window.position is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-31", "kind": "switch-tab", "args": { "window": 4242, "tabId": "javascript:alert(1)", "title": "x" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a fact the chat wants remembered: the user sees it and confirms it",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-40", "kind": "memory-save", "args": { "text": "Prefers answers in French" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "ask"
    },
    {
      "name": "a memory is one line",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-41", "kind": "memory-save", "args": { "text": "line one\nline two" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a web page the chat wants opened: the user sees the address and confirms it",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-50", "kind": "open-url", "args": { "url": "https://www.youtube.com/results?search_query=lofi" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "ask"
    },
    {
      "name": "only web pages: no file, no script, no other scheme",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-51", "kind": "open-url", "args": { "url": "file:///C:/Windows/System32/calc.exe" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "no user name before the host: the card would show the wrong site",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-52", "kind": "open-url", "args": { "url": "https://www.google.com@evil.example/" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "an address is one word: spaces are encoded",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-53", "kind": "open-url", "args": { "url": "https://www.google.com/search?q=two words" }, "intentId": "chat-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "dictating into another app's field reaches outside Coucou: the user confirms it",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-20", "kind": "insert-text", "args": { "text": "hi", "targetWindow": 1, "targetPid": 2 }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "ask"
    },
    {
      "name": "an insertion without a target window is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-21", "kind": "insert-text", "args": { "text": "hi", "targetWindow": 0, "targetPid": 2 }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "an insertion may not ask to submit",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-22", "kind": "insert-text", "args": { "text": "hi", "targetWindow": 1, "targetPid": 2, "pressEnter": true }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "opening an app reaches outside Coucou: the user confirms it",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-14", "kind": "launch-app", "args": { "appId": "figma-0a1b2c3d" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "ask"
    },
    {
      "name": "an app id that is a path or a command is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-15", "kind": "launch-app", "args": { "appId": "C:\\Windows\\System32\\cmd.exe /c del" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "an app launch with anything besides its id is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-16", "kind": "launch-app", "args": { "appId": "figma-0a1b2c3d", "arguments": "--evil" }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a pill set is allowed: Coucou's own pills, as Settings would",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-10", "kind": "pill-set", "args": { "mainPill": "integration_claude", "activeIntegrations": ["integration_github", "agent_claude-desktop"] }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "allow"
    },
    {
      "name": "a fifth pill is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-11", "kind": "pill-set", "args": { "mainPill": "integration_claude", "activeIntegrations": ["a", "b", "c", "d", "e"] }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "the main pill twice, or a pill twice, is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-12", "kind": "pill-set", "args": { "mainPill": "integration_claude", "activeIntegrations": ["integration_claude"] }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "a pill id that is not an id is refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-13", "kind": "pill-set", "args": { "mainPill": "../../settings", "activeIntegrations": [] }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    },
    {
      "name": "args of the wrong type are refused",
      "action": { "v": 5, "domain": "desktop-assistant", "id": "act-9", "kind": "chat-draft", "args": { "text": 42 }, "intentId": "cap-1", "expiresAtMs": 1060000 },
      "decision": "deny", "error": "invalid-args"
    }
